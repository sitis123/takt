# Файл — только шпаргалка: код не загружает .env автоматически.
# В PowerShell задавайте переменные так: $env:AI_API_KEY="..."
# В Cloudflare значения задаются в GitHub Secrets / Variables.

# Куда класть базу и сгенерированные файлы (по умолчанию ~/.takt)
TAKT_HOME=
TAKT_DB=
TAKT_OUT=

# Telegram-бот (получить у @BotFather)
TELEGRAM_BOT_TOKEN=
# Необязательный белый список чатов: 123,456
TELEGRAM_ALLOWED_CHAT_IDS=

# AI-провайдер с OpenAI-совместимым API. Без него работает локальный парсер.
AI_BASE_URL=
AI_API_KEY=
# Оставьте пустыми: модель подберётся автоматически
# (gemini-3.5-flash-lite для Gemini, gpt-4o-mini для OpenAI-совместимых).
AI_MODEL=
AI_VISION_MODEL=
