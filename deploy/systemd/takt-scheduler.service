[Unit]
Description=Такт — планировщик напоминаний
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=takt
Group=takt
WorkingDirectory=/opt/takt/app
EnvironmentFile=/opt/takt/.env
ExecStart=/opt/takt/venv/bin/python -m takt scheduler --interval 60
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
